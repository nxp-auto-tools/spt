/// local maxima

// maxs.lm  opcb maxsn_sel in_dattyp preproc in_pack out_bitfld in_tag cyc_extn, vec_sz, src_add, dest_add, src_add_inc, dest_add_inc
  define (instr=maxsLM) {

    width = 128;
    fields = (opc(0x17), opcb, ima_fld(0), max_mode(1), maxsn_sel, in_dattyp2, pre_proc,
        in_pack, out_mode, cyc_extn, in_tag, bitfld_size,
        vec_sz, src_add, dest_add, src_add_inc, dest_add_inc);

    dsyntax = ("maxs.lm %f %f %f %f %f %f %f %f, %f, %f%f_%f%f, %f%f_%f%f, %f, %f",
        opcb, maxsn_sel, in_dattyp2, pre_proc, in_pack, out_bitfld((out_mode << 2) + bitfld_size),
        in_tag, cyc_extn, vec_sz,
        DS_MEM1(src_add),
        DS_MEM(dest_add),
        src_add_inc, dest_add_inc);

    syntax = ("maxs.lm %f %f %f %f %f %f %f %f, %f, %f, %f, %f, %f",
        opcb, maxsn_sel, in_dattyp2, pre_proc, in_pack, out_bitfld, in_tag, cyc_extn, vec_sz,
