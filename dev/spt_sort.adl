    asm_rules = (
        R_maxs_vec_sz,
        R_src_oram_aligned,
        R_dest_oram_aligned
    );

    action = { };
  }

// maxs.lm.ind  opcb maxsn_sel in_dattyp preproc in_pack out_bitfld in_tag cyc_extn, vec_sz, src_add, src_add_inc, dest_add_inc
