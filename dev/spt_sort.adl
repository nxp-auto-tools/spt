        ds_src_ind(src_add),
        src_add_inc, dest_add_inc,
        DS_MEM2(gm_add));

    syntax = ("maxs.gm.ind %f %f %f %f %f %f, %f, %f, %f, %f, %f",
        opcb, thld_dir, maxsn_sel, in_dattyp2, pre_proc, in_pack, vec_sz,
        src_add,
        src_add_inc, dest_add_inc,
        gm_add);

    asm_rules = (
        R_maxs_vec_sz,
