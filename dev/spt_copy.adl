/// clear copy

// copy.clear  opcb vec_sz, dest_add, dest_add_inc, mask
  define (instr=copy_clear) {

    width = 128;
    fields = (opc(0x15), opcb, vec_sz,
        src_add(0x8000), dest_add, cp_type(11),
        mask_mode(0), dest_add_inc,
        cp_mask
    );

    dsyntax = ("copy.clear %f %f, %f_%f_%f_%f, %f, %f", opcb, vec_sz, DS_RAM(dest_add), dest_add_inc, cp_mask);
    syntax = ("copy.clear %f %f, %f, %f, %f", opcb, vec_sz, dest_add, dest_add_inc, cp_mask);

    asm_rules = (
        R_dest_ram_aligned,
        R_vec_sz_8
    );

    action = {};
  }

