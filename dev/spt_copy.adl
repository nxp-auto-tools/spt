        opcb, vec_sz, \
        src_add, \
        dest_add, \
        src_add_inc, dest_add_inc, blk_src_inc, blk_dest_inc, cp_mask \
        ); \
    dsyntax = ("copy." #x ".mask %f %f, %f_%f_%f_%f, %f_%f_%f_%f, %f, %f, %f, %f, %f", \
        opcb, vec_sz, \
        DS_RAM1(src_add), \
        DS_RAM(dest_add), \
